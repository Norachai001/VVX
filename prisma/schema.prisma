// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id               String   @id @default(uuid())
  uid              String   // LDAP/SSO user ID
  sport            String
  position         String
  experience       String
  achievement      String
  note             String
  files            Json     // Array of { name: string, url: string }
  status           String   @default("pending")
  submittedToStaff Boolean  @default(false)
  staffStatus      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
